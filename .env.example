# Infinity X Messenger — copy to .env and fill in values.
# Never commit real secrets.

NODE_ENV=development
APP_NAME=Infinity X Messenger
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Server
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=ixm
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=infinity_x
DATABASE_URL=postgresql://ixm:change_me_strong_password@localhost:5432/infinity_x?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Sessions (use a long random string in production)
SESSION_SECRET=generate_a_64_byte_random_string
SESSION_COOKIE_NAME=ixm_session
SESSION_TTL_SECONDS=1209600
SESSION_ABSOLUTE_TTL_SECONDS=2592000

# Rate limiting (per window)
AUTH_RATE_LIMIT_MAX=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_SECONDS=60
MESSAGE_RATE_LIMIT_MAX=40
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=10
UPLOAD_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

ACCESS_CODE_DUA=dua
ACCESS_CODE_ADIL=adil
ACCESS_CODE_GHOSTY=ghosty

# Uploads
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_BYTES=524288000

# SMTP (optional — email verification/reset logs the link in development if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Infinity X Messenger <noreply@example.com>

# Admin bootstrap (optional, one-time). Leave empty to skip.
# The matching user is promoted to admin only if they already exist.
BOOTSTRAP_ADMIN_EMAIL=

# Cloudflare Tunnel (do not commit the token)
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_HOSTNAME=

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
